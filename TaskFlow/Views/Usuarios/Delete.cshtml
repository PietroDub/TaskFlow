@model TaskFlow.Models.Usuario

@{
    ViewData["Title"] = "Excluir usuário";
}

<h1 class="tf-page-title h3 mb-2 text-danger">Excluir usuário</h1>

@if (ViewBag.ErroCarregamento != null)
{
    <a class="btn btn-outline-secondary mt-2" asp-action="Index">Voltar à lista</a>
}
else
{
    <p class="tf-page-lead small mb-4">Confirme a exclusão. As tarefas vinculadas a este usuário também serão removidas (cascata).</p>

    <div class="tf-card-soft p-4 mb-4" style="max-width: 520px;">
        <dl class="row mb-0">
            <dt class="col-sm-3 text-secondary small">@Html.DisplayNameFor(model => model.Nome)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>
            <dt class="col-sm-3 text-secondary small">@Html.DisplayNameFor(model => model.Email)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Email)</dd>
            <dt class="col-sm-3 text-secondary small">@Html.DisplayNameFor(model => model.Funcao)</dt>
            <dd class="col-sm-9">@Html.DisplayFor(model => model.Funcao)</dd>
        </dl>
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Excluir definitivamente</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
    </form>
}