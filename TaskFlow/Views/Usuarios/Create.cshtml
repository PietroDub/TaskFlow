@model TaskFlow.Models.Usuario

@{
    ViewData["Title"] = "Novo usuário";
}

<h1 class="tf-page-title h3 mb-2">Novo usuário</h1>
<p class="tf-page-lead small mb-4">Inclua nome completo, e-mail válido e função na equipe (ex.: Desenvolvedor).</p>

<div class="row">
    <div class="col-lg-7">
        <form asp-action="Create" class="tf-card-soft p-4">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Nome" class="form-label fw-semibold"></label>
                <input asp-for="Nome" class="form-control" placeholder="Ex.: João Silva" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold"></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="joao@email.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Funcao" class="form-label fw-semibold"></label>
                <input asp-for="Funcao" class="form-control" placeholder="Ex.: Desenvolvedor" />
                <span asp-validation-for="Funcao" class="text-danger"></span>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Salvar</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}