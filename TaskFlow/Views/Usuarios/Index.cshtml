@model IEnumerable<TaskFlow.Models.Usuario>
@{
    ViewData["Title"] = "Usuários";
}

<div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
    <div>
        <h1 class="tf-page-title h2 mb-2">Usuários</h1>
        <p class="tf-page-lead small mb-0">Membros da equipe que podem ser definidos como responsáveis pelas tarefas.</p>
    </div>
    <a class="btn btn-primary" asp-action="Create">Novo usuário</a>
</div>

<div class="tf-table-wrap">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Nome)</th>
                    <th>@Html.DisplayNameFor(model => model.Email)</th>
                    <th>@Html.DisplayNameFor(model => model.Funcao)</th>
                    <th class="text-end"></th>
                </tr>
            </thead>
            <tbody>
@foreach (var item in Model) {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.Nome)</td>
                    <td>@Html.DisplayFor(modelItem => item.Email)</td>
                    <td>@Html.DisplayFor(modelItem => item.Funcao)</td>
                    <td class="text-end text-nowrap">
                        <a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@item.Id">Editar</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-action="Details" asp-route-id="@item.Id">Detalhes</a>
                        <a class="btn btn-outline-danger btn-sm" asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                    </td>
                </tr>
}
            </tbody>
        </table>
    </div>
</div>

@if (!Model.Any() && ViewBag.ErroCarregamento == null)
{
    <p class="text-secondary mt-4 mb-0">Nenhum usuário cadastrado. Clique em <strong>Novo usuário</strong> para começar.</p>
}